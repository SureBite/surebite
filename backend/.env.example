PORT=5000
MONGO_URI=mongodb://localhost:27017/surebite
JWT_SECRET=your_super_secret_jwt_key
CLIENT_URL=http://localhost:5173
GEMINI_API_KEY=your_gemini_api_key

# --- Email Options ---
# Recommended for Render Free Tier (bypasses Render SMTP port blocking via HTTPS):
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender@gmail.com

# Or Resend HTTPS API:
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=SureBite <onboarding@resend.dev>

# Local Dev / Non-blocked SMTP:
EMAIL_USER=your_restaurant_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
